# Copy to `.env` and adjust for your setup.
#
# Android emulator  -> http://10.0.2.2:4000   (alias for the host loopback)
# Physical device   -> http://<your-lan-ip>:4000
# iOS simulator     -> http://localhost:4000
# Web               -> http://localhost:4000
EXPO_PUBLIC_API_URL=http://192.168.1.102:4000
