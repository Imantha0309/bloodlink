# BloodLink app environment.
#
# Metro inlines every EXPO_PUBLIC_* value at build time, so changing this file
# requires restarting the dev server with a cleared cache:
#
#   npx expo start --clear
#
# Only non-secret values belong in this file — anything prefixed EXPO_PUBLIC_
# is compiled into the shipped bundle and is readable by anyone with the app.
#
# 10.0.2.2 is the Android emulator's alias for the host machine's loopback.
# On a physical device or Expo Go, replace it with your computer's LAN address
# (e.g. http://192.168.1.20:4000) and make sure both are on the same network.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
