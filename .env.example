# BloodLink app environment — copy to `.env` and adjust for your machine.
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows PowerShell)
#
# `.env` is gitignored: this file is per-developer.
#
# Metro inlines every EXPO_PUBLIC_* value at build time, so changing it requires
# restarting the dev server with a cleared cache:
#
#   npx expo start --clear
#
# Only non-secret values belong here — anything prefixed EXPO_PUBLIC_ is compiled
# into the shipped bundle and is readable by anyone with the app.
#
# Firebase Web App config for the `bloodlink-c75d7` project. These values come
# from `firebase apps:sdkconfig WEB <appId>`. The app talks to backend services
# (Firebase Auth + Data Connect) directly, so there is no custom API base URL.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=bloodlink-c75d7.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=bloodlink-c75d7
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=bloodlink-c75d7.firebasestorage.app
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# ^ Required for FCM push notifications. Get from Firebase console → Project Settings → Cloud Messaging.
#   Push itself does not work in local emulator mode — see the README.

# ---------------------------------------------------------------------------
# Local emulator mode
# ---------------------------------------------------------------------------
# true  = talk to the local emulator suite; requires no Blaze plan.
# false = talk to the deployed project.
#
# With emulators on, start the suite first:
#   firebase emulators:start --only "auth,dataconnect"
EXPO_PUBLIC_USE_EMULATORS=true

# Where the emulator is reachable from the device running the app:
#   Android emulator  -> 10.0.2.2
#   iOS simulator/web -> localhost
#   physical device   -> this machine's LAN IPv4 (`ipconfig`)
EXPO_PUBLIC_EMULATOR_HOST=localhost