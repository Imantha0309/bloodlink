# BloodLink API environment — copy to `.env` and fill in the blanks.
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows PowerShell)
#
# `.env` is gitignored. This file is the ONLY place the database credentials
# belong: never put them in frontend/.env, and never behind an EXPO_PUBLIC_*
# name, because Metro compiles those into the shipped app bundle.

# Port the API listens on. Must match EXPO_PUBLIC_API_URL in frontend/.env.
PORT=4000

# MongoDB Atlas connection string. Replace <user> and <password>.
# Atlas → Database → Connect → Drivers gives you this exact form.
MONGODB_URI=mongodb+srv://admin:root@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name inside the cluster.
MONGODB_DB=bloodlink

# Signing key for session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# A short or shared value here lets anyone mint a token for any account.
JWT_SECRET=replace-me-with-a-long-random-string

# How long a signed-in session lasts, in days. The app stores this expiry and
# signs the user out when it passes, so shortening it forces re-login.
SESSION_TTL_DAYS=30

# Comma-separated origins allowed to call the API. `*` is fine for local
# development; pin it to your real origins before deploying.
CORS_ORIGIN=*

# Failed sign-ins before an account is temporarily locked.
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_MINUTES=15
