{
  "expo": {
    "name": "Bloodlink",
    "slug": "bloodlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bloodlink",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F8FC",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.bloodlink.lk"
    },
    "android": {
      "package": "com.bloodlink.lk",
      "adaptiveIcon": {
        "backgroundColor": "#D7193F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "BloodLink uses the camera to scan donor intake QR codes for hospital check-in."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7F8",
          "image": "./assets/images/loadingScreenimage.png",
          "imageWidth": 320,
          "resizeMode": "contain"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
