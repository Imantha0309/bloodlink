# BloodLink backend environment.
#
# PORT              — HTTP port. The app's .env must point at the same port.
# BLOODLINK_DB_PATH — SQLite file location, relative to the server folder.
# HOST              — bind address. 0.0.0.0 lets a physical phone on the same
#                     network reach the server; localhost restricts it to this
#                     machine (the emulator's 10.0.2.2 alias still works).
PORT=4000
HOST=0.0.0.0
BLOODLINK_DB_PATH=./data/bloodlink.db
